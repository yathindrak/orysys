[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-random-local-cookie-secret"
expose_tokens = ["access"]

[auth.skycloak]
client_id = "orysys-ui"
client_secret = "replace-with-the-hosted-client-secret"
server_metadata_url = "https://YOUR-SKYCLOAK-HOST/realms/orysys/.well-known/openid-configuration"
