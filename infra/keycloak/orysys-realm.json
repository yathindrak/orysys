{
  "realm": "orysys",
  "enabled": true,
  "displayName": "Orysys Assessment",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "roles": {
    "client": {
      "orysys-api": [
        {"name": "viewer"},
        {"name": "analyst"},
        {"name": "administrator"}
      ]
    }
  },
  "clients": [
    {
      "clientId": "orysys-api",
      "name": "Orysys API",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "orysys-ui",
      "name": "Orysys Streamlit",
      "enabled": true,
      "publicClient": false,
      "secret": "local-streamlit-change-me",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:8501/oauth2callback"],
      "webOrigins": ["http://localhost:8501"],
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "orysys-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "orysys-api",
            "access.token.claim": "true"
          }
        },
        {
          "name": "tenant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        },
        {
          "name": "departments",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "departments",
            "claim.name": "departments",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "clearance",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "clearance",
            "claim.name": "clearance",
            "jsonType.label": "int",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "viewer",
      "enabled": true,
      "emailVerified": true,
      "attributes": {"tenant_id": ["commercial-bank"], "departments": ["payments"], "clearance": ["1"]},
      "credentials": [{"type": "password", "value": "local-demo-change-me", "temporary": true}],
      "clientRoles": {"orysys-api": ["viewer"]}
    },
    {
      "username": "analyst",
      "enabled": true,
      "emailVerified": true,
      "attributes": {"tenant_id": ["commercial-bank"], "departments": ["payments"], "clearance": ["3"]},
      "credentials": [{"type": "password", "value": "local-demo-change-me", "temporary": true}],
      "clientRoles": {"orysys-api": ["analyst"]}
    },
    {
      "username": "administrator",
      "enabled": true,
      "emailVerified": true,
      "attributes": {"tenant_id": ["commercial-bank"], "departments": ["payments", "security"], "clearance": ["8"]},
      "credentials": [{"type": "password", "value": "local-demo-change-me", "temporary": true}],
      "clientRoles": {"orysys-api": ["administrator"]}
    }
  ]
}
